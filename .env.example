# URL do servidor Evolution API
EVOLUTION_API_URL=https://seu-servidor-evolution-api.com

# Chave API para autenticar na Evolution API
EVOLUTION_API_KEY=sua-chave-api

# Nome da instância na Evolution API (o nome que aparece no Manager, não o token/ID)
EVOLUTION_API_INSTANCE=nome-da-sua-instancia

# Porta do servidor HTTP do MCP (opcional)
PORT=3000

# Habilitar servidor HTTP do MCP: rotas /mcp, /sse e WebSocket (true/false)
ENABLE_WEBSOCKET=false
